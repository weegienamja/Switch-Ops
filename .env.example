# SwitchOps — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Credentials are preferred to be stored via OS keyring (see backend/app/credential_store.py).

# Backend
SWITCHOPS_HOST=127.0.0.1
SWITCHOPS_PORT=8765
SWITCHOPS_CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost

# Mock mode — leave on until real switch credentials are configured
SWITCH_MOCK_MODE=true

# Write actions disabled by default
ENABLE_WRITE_ACTIONS=false

# Switch credentials (only used if keyring unavailable)
# DO NOT commit real values.
SWITCH_HOST=192.0.2.190
SWITCH_USERNAME=operator
SWITCH_PASSWORD=__REPLACE_WITH_LOCAL_SECRET__
SWITCH_ENABLE_SECRET=__REPLACE_WITH_LOCAL_SECRET__
SWITCH_DEVICE_TYPE=cisco_ios

# Legacy SSH options for old Cisco IOS
SWITCH_LEGACY_SSH=true
