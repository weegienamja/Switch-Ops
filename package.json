{
  "name": "switchops",
  "version": "0.8.0",
  "private": true,
  "description": "SwitchOps — local desktop operations dashboard for Cisco IOS Catalyst switches.",
  "scripts": {
    "dev": "pnpm --filter @switchops/frontend dev",
    "build": "pnpm --filter @switchops/frontend build",
    "test": "pnpm --filter @switchops/frontend typecheck",
    "lint": "pnpm --filter @switchops/frontend lint",
    "test:backend": ".venv/Scripts/python.exe -m pytest backend",
    "test:lab": ".venv/Scripts/python.exe -m backend.resilience_lab",
    "test:e2e:lab": "node scripts/lab-assurance-e2e.mjs",
    "desktop:check": "powershell -ExecutionPolicy Bypass -File desktop/scripts/check-sidecar-freshness.ps1",
    "desktop:dev": "pnpm desktop:check && pnpm --filter @switchops/desktop tauri dev",
    "desktop:build": "pnpm desktop:check && pnpm --filter @switchops/desktop tauri build",
    "verify:secrets": "powershell -ExecutionPolicy Bypass -File scripts/verify-no-secrets.ps1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "vite": "6.4.3"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
